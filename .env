# ==================================
# DiDong2_Shoeshop - Mobile App Configuration
# ==================================

# API Base URL Configuration
# ==========================

# === CHO WEB BROWSER (localhost:8081) ===
# Khi chạy trên web browser, sử dụng localhost
EXPO_PUBLIC_API_URL=http://localhost:8080

# === CHO THIẾT BỊ DI ĐỘNG THỰC ===
# Khi test trên điện thoại thật, uncomment dòng dưới và comment dòng trên
# Thay IP bằng IP máy tính của bạn (chạy `ipconfig` để lấy)
# EXPO_PUBLIC_API_URL=http://10.121.244.218:8080

# === CHO EMULATOR ANDROID ===
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# === CHO iOS SIMULATOR ===
# EXPO_PUBLIC_API_URL=http://localhost:8080

# Legacy (cho một số cấu hình cũ)
API_BASE_URL=http://localhost:8080/api